NODE_ENV="test"
PORT="3000"

# Renamed from the historical MONGDB_URI typo — see docs/setup.md
MONGODB_URI="mongodb://localhost:27017/task-management-test"

JWT_SECRET="test-only-secret-do-not-use-in-prod"
JWT_EXPIRES_IN="1h"

# Lower cost factor than dev/prod — test data only, favors fast test runs.
BCRYPT_SALT_ROUNDS="4"
