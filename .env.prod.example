NODE_ENV="production"
PORT="3000"

# Renamed from the historical MONGDB_URI typo — see docs/setup.md
MONGODB_URI="mongodb://localhost:27017/task-management"

# REQUIRED: replace with a real, long, randomly generated secret before deploying —
# e.g. `openssl rand -hex 32`. Never reuse the dev/test secret in production.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1h"

BCRYPT_SALT_ROUNDS="10"
