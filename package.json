{
  "name": "postman-demo",
  "version": "1.0.0",
  "description": "The simplest Task Management API for Postman Demos",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pm:dashboard": "node scripts/pm/generate-dashboard.mjs",
    "pm:check": "node scripts/pm/check-docs.mjs",
    "seed:dev": "tsx scripts/seed.ts .env",
    "seed:test": "tsx scripts/seed.ts .env.test",
    "seed:prod": "node scripts/seed.prod.mjs",
    "docker:dev": "docker compose --env-file .env -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose --env-file .env -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:test": "docker compose --env-file .env.test -f docker-compose.yml -f docker-compose.test.yml run --build --rm api",
    "docker:prod": "docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml down",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/compadrejunior/postman-demo.git"
  },
  "keywords": [
    "Postman",
    "API",
    "Task"
  ],
  "author": "José Compadre Junior",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/compadrejunior/postman-demo/issues"
  },
  "homepage": "https://github.com/compadrejunior/postman-demo#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.11.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "mongodb-memory-server": "^10.1.2",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  }
}
