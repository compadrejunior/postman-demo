current_branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$current_branch" = "master" ] || [ "$current_branch" = "main" ]; then
  echo "Direct commits to '$current_branch' are not allowed. Create a Gitflow branch (feature/*, bugfix/*, hotfix/*, release/*) instead — see CLAUDE.md > Git workflow." >&2
  exit 1
fi

npm run test:coverage
